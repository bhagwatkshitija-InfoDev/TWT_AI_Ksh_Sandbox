# Document QA Agent Configuration for TWT_AI_Ksh_Sandbox

# Repository Settings
SOURCE_REPO_PATH=D:/TWT_AI/TWT_AI_Ksh_Sandbox
REPO_NAME=TWT_AI_Ksh_Sandbox

# Database
DATABASE_URL=sqlite:///D:/TWT_AI/data/docqa_ksh_sandbox.db

# Storage and Reports
STORAGE_DIR=D:/TWT_AI/storage/ksh_sandbox
REPORT_DIR=D:/TWT_AI/reports/ksh_sandbox

# Logging
LOG_LEVEL=INFO
LOG_DIR=D:/TWT_AI/logs/ksh_sandbox

# Document Processing
SUPPORTED_FORMATS=["pdf", "docx", "md"]
SUPPORTED_LANGUAGES=["de", "zh_CN", "en"]

# Language Detection
LANGUAGE_DETECTION_MIN_CONFIDENCE=0.7

# MCP Server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Analysis Settings
ENABLE_PDF_REPORTS=true
ENABLE_HTML_REPORTS=true
ENABLE_JSON_REPORTS=true
INCLUDE_PAGE_REFERENCES=true
INCLUDE_COORDINATES=true
INCLUDE_EXAMPLES=true

# Performance
CACHE_RESULTS=true
PARALLEL_PROCESSING=true
MAX_PARALLEL_PAGES=4
MAX_FILE_SIZE_MB=100
